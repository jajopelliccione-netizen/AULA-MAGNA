# --- Firebase (Impostazioni progetto > Le tue app > App web > Config) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- YouTube Data API v3 (chiave limitata al dominio del sito) ---
VITE_YOUTUBE_API_KEY=

# --- Facoltative ---
# UID degli admin (separati da virgola): serve solo a nascondere il pannello agli altri.
# La sicurezza vera è in firestore.rules.
VITE_ADMIN_UIDS=
# Indirizzo pubblico che finisce nel QR code (se vuoto usa il dominio corrente)
VITE_PUBLIC_URL=
